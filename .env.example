VITE_API_URL=/api
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:replace-with-url-encoded-password@127.0.0.1:5432/ms_stakeholder_map
STAKEHOLDER_REPOSITORY=database
REQUIRE_DATABASE=true
SEED_DEMO_DATA=false
AUTO_CREATE_SCHEMA=false
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AUTH_MODE=development
DEVELOPMENT_ACTOR=local-developer
DEVELOPMENT_ROLES=Account Admin
UPLOAD_ROOT=backend/uploads
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_DURABLE=true
# Safe default: grounded retrieval and extractive answers stay inside this app.
AI_PROVIDER=local
AI_MAX_SOURCES=8
# To enable model-generated answers, obtain enterprise approval before sending
# retrieved account excerpts to an external provider, then set all four values:
# AI_PROVIDER=openai
# AI_MODEL=<approved-model-id>
# OPENAI_API_KEY=<secret>
# AI_EXTERNAL_DATA_APPROVED=true
